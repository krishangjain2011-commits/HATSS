================================================================================
# HATSS Environment Configuration - EXAMPLE
# Home Automated Threat Security System
# Development Environment Setup
================================================================================

# ================================================================================
# DATABASE CONFIGURATION
# ================================================================================
POSTGRES_DB=hatss
POSTGRES_USER=hatss
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432

# ================================================================================
# APPLICATION PORTS
# ================================================================================
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ================================================================================
# FASTAPI CONFIGURATION
# ================================================================================
HATSS_ENVIRONMENT=development
HATSS_DEBUG=false
HATSS_DOCS_ENABLED=true
HATSS_DATABASE_HOST=localhost
HATSS_DATABASE_PORT=5432
HATSS_CORS_ORIGINS=["http://localhost:5173"]
HATSS_TRUSTED_HOSTS=["localhost","127.0.0.1","testserver","backend"]

# ================================================================================
# ESP32 SENSOR INTEGRATION
# ================================================================================
# Direct ESP32 connection (Access Point Mode)
ESP32_AP_SSID=HATSS_SECURITY_NET
ESP32_AP_PASSWORD=HATSS1234
ESP32_API_URL=http://192.168.4.1

# ESP32 WiFi Station Mode (Optional - for backend synchronization)
ESP32_WIFI_SSID=YourWiFiSSID
ESP32_WIFI_PASSWORD=YourWiFiPassword
ESP32_BACKEND_URL=http://localhost:8000

# ================================================================================
# FACE RECOGNITION CONFIGURATION
# ================================================================================
# YOLOv8 Model (auto-downloads on first run - ~6.3MB)
YOLO_MODEL=yolov8n
FACE_RECOGNITION_THRESHOLD=0.35

# ================================================================================
# SENSOR CONFIGURATION
# ================================================================================
# Water Level Sensor
WATER_LEVEL_THRESHOLD=75

# Gas Sensor (MQ2)
MQ2_THRESHOLD=2200
MQ2_RATING_MAX=10

# Motion Sensor (IR)
MOTION_SENSOR_DEBOUNCE=5

# Flame Sensor
FLAME_SENSOR_DEBOUNCE=5

# Gas Sensor Debounce
GAS_SENSOR_DEBOUNCE=5

# ================================================================================
# ALARM CONFIGURATION
# ================================================================================
# Buzzer Settings
BUZZER_ENABLED=true
BUZZER_PIN=25
BUZZER_FREQUENCY_HIGH=2500
BUZZER_FREQUENCY_LOW=1800

# Alert Cooldown (seconds between consecutive alerts)
ALERT_COOLDOWN=8

# ================================================================================
# MONITORING FEATURES
# ================================================================================
# Enable/Disable specific monitoring features
ENABLE_FACE_RECOGNITION=true
ENABLE_MOTION_DETECTION=true
ENABLE_FIRE_DETECTION=true
ENABLE_GAS_DETECTION=true
ENABLE_WATER_LEVEL_MONITORING=true
ENABLE_INTRUSION_DETECTION=true
ENABLE_OLED_DISPLAY=true
ENABLE_WIFI=true
ENABLE_BACKEND_SYNC=true

# ================================================================================
# DATA STORAGE
# ================================================================================
# Intruder snapshots storage
INTRUDER_SNAP_DIR=backend/data/intruder_snaps
KNOWN_FACES_DIR=backend/data/known_faces

# ================================================================================
# FRONTEND CONFIGURATION
# ================================================================================
# Sensor data polling interval (milliseconds)
SENSOR_POLL_INTERVAL=10

# Display theme
THEME=dark

# ================================================================================
# LOGGING & DEBUG
# ================================================================================
LOG_LEVEL=INFO
DEBUG_MODE=false
