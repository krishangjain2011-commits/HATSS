================================================================================
# HATSS Environment Configuration - EXAMPLE
# Home Automated Threat Security System
# Production/Render Deployment Setup
================================================================================

# ================================================================================
# DATABASE CONFIGURATION
# ================================================================================
POSTGRES_DB=hatss
POSTGRES_USER=hatss
POSTGRES_PASSWORD=set-secure-password-in-render-dashboard
POSTGRES_PORT=5432

# ================================================================================
# APPLICATION PORTS
# ================================================================================
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ================================================================================
# FASTAPI CONFIGURATION
# ================================================================================
HATSS_ENVIRONMENT=production
HATSS_DEBUG=false
HATSS_DOCS_ENABLED=false
HATSS_DATABASE_HOST=postgresql-hostname.render.com
HATSS_DATABASE_PORT=5432
HATSS_DATABASE_NAME=hatss
HATSS_DATABASE_USER=hatss
HATSS_DATABASE_PASSWORD=set-secure-password-in-render-dashboard
HATSS_CORS_ORIGINS=["https://hatss-frontend.onrender.com"]
HATSS_TRUSTED_HOSTS=["hatss-backend.onrender.com","localhost"]

# ================================================================================
# ESP32 SENSOR INTEGRATION (Optional)
# ================================================================================
# When running on local network with ESP32
HATSS_ESP32_IP=192.168.4.1
ESP32_AP_SSID=HATSS_SECURITY_NET
ESP32_AP_PASSWORD=HATSS1234

# For production, set to production backend URL
ESP32_BACKEND_URL=https://hatss-backend.onrender.com

# ================================================================================
# FACE RECOGNITION CONFIGURATION
# ================================================================================
YOLO_MODEL=yolov8n
FACE_RECOGNITION_THRESHOLD=0.35

# ================================================================================
# SENSOR CONFIGURATION
# ================================================================================
WATER_LEVEL_THRESHOLD=75
MQ2_THRESHOLD=2200
MQ2_RATING_MAX=10
MOTION_SENSOR_DEBOUNCE=5
FLAME_SENSOR_DEBOUNCE=5
GAS_SENSOR_DEBOUNCE=5

# ================================================================================
# ALARM CONFIGURATION
# ================================================================================
BUZZER_ENABLED=true
BUZZER_PIN=25
BUZZER_FREQUENCY_HIGH=2500
BUZZER_FREQUENCY_LOW=1800
ALERT_COOLDOWN=8

# ================================================================================
# MONITORING FEATURES
# ================================================================================
ENABLE_FACE_RECOGNITION=true
ENABLE_MOTION_DETECTION=true
ENABLE_FIRE_DETECTION=true
ENABLE_GAS_DETECTION=true
ENABLE_WATER_LEVEL_MONITORING=true
ENABLE_INTRUSION_DETECTION=true
ENABLE_OLED_DISPLAY=false
ENABLE_WIFI=true
ENABLE_BACKEND_SYNC=false

# ================================================================================
# DATA STORAGE (Note: Ephemeral on Render, use persistent storage in production)
# ================================================================================
INTRUDER_SNAP_DIR=backend/data/intruder_snaps
KNOWN_FACES_DIR=backend/data/known_faces

# ================================================================================
# FRONTEND CONFIGURATION
# ================================================================================
SENSOR_POLL_INTERVAL=10
THEME=dark
VITE_API_URL=https://hatss-backend.onrender.com

# ================================================================================
# LOGGING & DEBUG
# ================================================================================
LOG_LEVEL=INFO
DEBUG_MODE=false

