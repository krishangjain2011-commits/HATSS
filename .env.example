# Copy this file to .env before starting Docker Compose.
# This file is safe to commit; replace the password with a unique local value.

# PostgreSQL
POSTGRES_DB=hatss
POSTGRES_USER=hatss
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432

# Application ports exposed to the host
BACKEND_PORT=8000
FRONTEND_PORT=5173

# FastAPI runtime configuration
HATSS_ENVIRONMENT=development
HATSS_DEBUG=false
HATSS_DOCS_ENABLED=true
HATSS_DATABASE_HOST=localhost
HATSS_DATABASE_PORT=5432
HATSS_CORS_ORIGINS=["http://localhost:5173"]
HATSS_TRUSTED_HOSTS=["localhost","127.0.0.1","testserver","backend"]
